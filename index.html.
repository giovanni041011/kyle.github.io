                <!-- Section 4: Dynamic Dynamic Upload Lists -->
                <h3 style="color: var(--accent); margin-top: 2rem; margin-bottom: 1rem;">4. Kelola Kenangan, Sekolah, Prestasi, Univ & Nasihat</h3>
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">Upload gambar dan isi rincian untuk bagian-bagian yang terkait dynamic media.</p>

                <!-- Kenangan Upload -->
                <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem;">
                    <h4>+ Tambah Foto Kenangan</h4>
                    <div class="grid-2 mt-1">
                        <input type="file" accept="image/*" id="input-kenanganFile">
                        <input type="text" id="input-kenanganCap" placeholder="Keterangan foto...">
                    </div>
                    <button type="button" class="admin-btn mt-1" style="padding:0.4rem 0.8rem; font-size:0.8rem;" onclick="addKenangan()">Tambah Kenangan</button>
                </div>

                <!-- Sekolah Dynamic Edit -->
                <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem;">
                    <h4>Edit Data Sekolah (TK, SD, SMP, SMA, Kuliah)</h4>
                    <div id="adminPendidikanInputs"></div>
                </div>

                <!-- Universitas Impian Dynamic Edit -->
                <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem;">
                    <h4>Edit 3 Universitas Impian</h4>
                    <div id="adminUnivInputs"></div>
                </div>

                <!-- Nasihat Dynamic Edit -->
                <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem;">
                    <h4>+ Tambah Nasihat Guru / Masyaikh</h4>
                    <div class="grid-2 mt-1">
                        <input type="text" id="input-nasihatGuru" placeholder="Nama Guru/Syaikh">
                        <textarea id="input-nasihatTeks" placeholder="Isi Nasihat..."></textarea>
                    </div>
                    <button type="button" class="admin-btn mt-1" style="padding:0.4rem 0.8rem; font-size:0.8rem;" onclick="addNasihat()">Tambah Nasihat</button>
                </div>

                <div style="position: sticky; bottom: 0; background: #1e293b; padding: 1rem 0; border-top: 1px solid var(--border); margin-top: 2rem;">
                    <button type="submit" class="admin-btn" style="width: 100%; font-size: 1rem;">SIMPAN SELURUH PERUBAHAN</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Engine -->
    <script>
        // Data Default Template
        const defaultData = {
            fotoProfil: "https://via.placeholder.com/150",
            nama: "Ahmad Fulan",
            ttl: "Jakarta, 1 Januari 2005",
            asalKota: "Jakarta",
            alamatPribadi: "Jl. Merdeka No. 45, Jakarta Pusat",
            hafalan: "30 Juz",
            citaCita: "Software Engineer & Akademisi",
            hobi: "Membaca, Coding, Memanah",
            motto: "Sebaik-baik manusia adalah yang paling bermanfaat bagi orang lain.",
            
            // Data Orangtua
            alamatOrtu: "Jl. Mawar No. 12, Bandung",
            namaAyah: "Fulan Senior",
            ttlAyah: "Bandung, 15 Mei 1975",
            asalKotaAyah: "Bandung",
            smpAyah: "SMPN 1 Bandung",
            smaAyah: "SMAN 3 Bandung",
            kuliahAyah: "S1 Teknik",
            pekerjaanAyah: "Wiraswasta",

            namaIbu: "Fulanah",
            ttlIbu: "Bogor, 20 Agustus 1978",
            asalKotaIbu: "Bogor",
            smpIbu: "SMPN 2 Bogor",
            smaIbu: "SMAN 1 Bogor",
            kuliahIbu: "S1 Pendidikan",
            pekerjaanIbu: "Guru",
            namaAnak: "1. Ahmad Fulan\n2. Fatimah Az-Zahra",

            // Sosmed
            wa: "6281234567890",
            gmail: "fulan@gmail.com",
            ig: "ahmad_fulan",
            fb: "Ahmad Fulan",
            tiktok: "ahmad_fulan_official",

            // Dynamic Arrays
            kenangan: [
                { img: "https://via.placeholder.com/300x200", cap: "Momen wisuda tahfidz" }
            ],
            pendidikan: [
                { level: "TK", nama: "TK Islam Terpadu", lokasi: "Jakarta", img: "https://via.placeholder.com/300x180", prestasi: "Juara 1 Lomba Mewarnai" },
                { level: "SD", nama: "SDIT Al-Azhar", lokasi: "Jakarta", img: "https://via.placeholder.com/300x180", prestasi: "Juara 2 TPA Cerdas Cermat" },
                { level: "SMP", nama: "SMP Al-Kahfi", lokasi: "Bogor", img: "https://via.placeholder.com/300x180", prestasi: "Juara 1 Lomba Pidato Bahasa Arab" },
                { level: "SMA", nama: "SMA Negeri 1", lokasi: "Jakarta", img: "https://via.placeholder.com/300x180", prestasi: "Medali Emas OSN Informatika" },
                { level: "Kuliah", nama: "Universitas Indonesia", lokasi: "Depok", img: "https://via.placeholder.com/300x180", prestasi: "Mahasiswa Berprestasi Tingkat Fakultas" }
            ],
            universitas: [
                { nama: "Universitas Indonesia", jurusan: "Teknik Informatika", img: "https://via.placeholder.com/300x180" },
                { nama: "Institut Teknologi Bandung", jurusan: "Sains Data", img: "https://via.placeholder.com/300x180" },
                { nama: "Universitas Gadjah Mada", jurusan: "Ilmu Komputer", img: "https://via.placeholder.com/300x180" }
            ],
            nasihat: [
                { guru: "Syaikh Dr. Abdullah", teks: "Ihlaslah dalam menuntut ilmu, karena ilmu tanpa keikhlasan seperti pohon tanpa buah." },
                { guru: "KH. Hasan Basri", teks: "Jagalah Al-Qur'an dalam dadamu, niscaya Al-Qur'an akan menjagamu di setiap langkah hidupmu." }
            ]
        };

        // Initialize Data Store
        let appData = JSON.parse(localStorage.getItem('portfolioDataDB')) || defaultData;

        // Navigation Tabs Engine
        function switchTab(index) {
            document.querySelectorAll('.tab-btn').forEach((btn, i) => {
                btn.classList.toggle('active', i === index);
            });
            document.querySelectorAll('.tab-content').forEach((content, i) => {
                content.classList.toggle('active', i === index);
            });
        }

        // Render Data into DOM
        function renderUI() {
            // Text values
            const fields = [
                'nama','ttl','asalKota','alamatPribadi','hafalan','citaCita','hobi','motto',
                'alamatOrtu','namaAyah','ttlAyah','asalKotaAyah','smpAyah','smaAyah','kuliahAyah','pekerjaanAyah',
                'namaIbu','ttlIbu','asalKotaIbu','smpIbu','smaIbu','kuliahIbu','pekerjaanIbu','namaAnak',
                'wa','gmail','ig','fb','tiktok'
            ];

            fields.forEach(f => {
                const el = document.getElementById('display-' + f);
                if (el) el.innerText = appData[f] || '-';
            });

            // Profile Picture
            document.getElementById('display-fotoProfil').src = appData.fotoProfil;

            // Social Media Links
            document.getElementById('link-wa').href = `https://wa.me/${appData.wa}`;
            document.getElementById('link-gmail').href = `mailto:${appData.gmail}`;
            document.getElementById('link-ig').href = `https://instagram.com/${appData.ig}`;
            document.getElementById('link-fb').href = `https://facebook.com/${appData.fb}`;
            document.getElementById('link-tiktok').href = `https://tiktok.com/@${appData.tiktok}`;

            // Render Kenangan
            const kenanganGrid = document.getElementById('display-kenanganGrid');
            kenanganGrid.innerHTML = appData.kenangan.map(k => `
                <div class="gallery-item">
                    <img src="${k.img}" alt="Kenangan">
                    <div class="gallery-cap">${k.cap}</div>
                </div>
            `).join('');

            // Render Pendidikan
            const pendidikanGrid = document.getElementById('display-pendidikanGrid');
            pendidikanGrid.innerHTML = appData.pendidikan.map(p => `
                <div class="glass-card interactive-card">
                    <span class="badge">${p.level}</span>
                    <img src="${p.img}" class="card-img" alt="${p.nama}">
                    <h3 style="margin-bottom:0.3rem;">${p.nama}</h3>
                    <p style="font-size:0.85rem; color:var(--text-muted);"><i class="fa-solid fa-location-dot"></i> ${p.lokasi}</p>
                </div>
            `).join('');

            // Render Prestasi (dari array Pendidikan)
            const prestasiGrid = document.getElementById('display-prestasiGrid');
            prestasiGrid.innerHTML = appData.pendidikan.map(p => `
                <div class="glass-card interactive-card">
                    <span class="badge">Prestasi ${p.level}</span>
                    <h3 style="margin-bottom:0.5rem; color:var(--accent);"><i class="fa-solid fa-trophy"></i> ${p.prestasi}</h3>
                    <p style="font-size:0.85rem; color:var(--text-muted);">Diukir saat menempuh pendidikan di ${p.nama}</p>
                </div>
            `).join('');

            // Render Universitas Impian
            const univGrid = document.getElementById('display-univGrid');
            univGrid.innerHTML = appData.universitas.map(u => `
                <div class="glass-card interactive-card">
                    <img src="${u.img}" class="card-img" alt="${u.nama}">
                    <h3>${u.nama}</h3>
                    <p style="color:var(--accent); font-weight:600; margin-top:0.3rem;">${u.jurusan}</p>
                </div>
            `).join('');

            // Render Nasihat Guru
            const nasihatGrid = document.getElementById('display-nasihatGrid');
            nasihatGrid.innerHTML = appData.nasihat.map(n => `
                <div class="glass-card quote-card interactive-card">
                    <i class="fa-solid fa-quote-right quote-icon"></i>
                    <p style="font-size:1.05rem; line-height:1.6; margin-bottom:1rem; font-style:italic;">"${n.teks}"</p>
                    <h4 style="color:var(--accent);">- ${n.guru}</h4>
                </div>
            `).join('');
        }

        /* ADMIN SYSTEM FUNCTIONS */
        function openAdmin() {
            document.getElementById('adminModal').style.display = 'block';
            document.getElementById('adminLoginScreen').style.display = 'block';
            document.getElementById('adminDashboardScreen').style.display = 'none';
        }

        function closeAdmin() {
            document.getElementById('adminModal').style.display = 'none';
        }

        function verifyAdmin() {
            const pwd = document.getElementById('adminPasswordInput').value;
            if (pwd === 'ADMIN2026') {
                document.getElementById('adminLoginScreen').style.display = 'none';
                document.getElementById('adminDashboardScreen').style.display = 'block';
                populateAdminForms();
            } else {
                alert('Password Admin Salah!');
            }
        }

        function populateAdminForms() {
            const fields = [
                'nama','ttl','asalKota','alamatPribadi','hafalan','citaCita','hobi','motto',
                'alamatOrtu','namaAyah','ttlAyah','asalKotaAyah','smpAyah','smaAyah','kuliahAyah','pekerjaanAyah',
                'namaIbu','ttlIbu','asalKotaIbu','smpIbu','smaIbu','kuliahIbu','pekerjaanIbu','namaAnak',
                'wa','gmail','ig','fb','tiktok'
            ];

            fields.forEach(f => {
                const el = document.getElementById('input-' + f);
                if (el) el.value = appData[f] || '';
            });

            // Dynamic Inputs Generation for Pendidikan
            const pendContainer = document.getElementById('adminPendidikanInputs');
            pendContainer.innerHTML = appData.pendidikan.map((p, i) => `
                <div style="border-bottom:1px solid var(--border); padding:0.5rem 0; margin-bottom:0.5rem;">
                    <strong>Level ${p.level}</strong>
                    <div class="grid-2 mt-1">
                        <input type="text" value="${p.nama}" onchange="appData.pendidikan[${i}].nama=this.value" placeholder="Nama Sekolah">
                        <input type="text" value="${p.lokasi}" onchange="appData.pendidikan[${i}].lokasi=this.value" placeholder="Lokasi">
                        <input type="text" value="${p.prestasi}" onchange="appData.pendidikan[${i}].prestasi=this.value" placeholder="Prestasi">
                        <div>
                            <label style="font-size:0.75rem;">Ganti Foto Sekolah:</label>
                            <input type="file" accept="image/*" onchange="handleNestedImageUpload(this, 'pendidikan', ${i})">
                        </div>
                    </div>
                </div>
            `).join('');

            // Dynamic Inputs Generation for Universitas
            const univContainer = document.getElementById('adminUnivInputs');
            univContainer.innerHTML = appData.universitas.map((u, i) => `
                <div style="border-bottom:1px solid var(--border); padding:0.5rem 0; margin-bottom:0.5rem;">
                    <strong>Univ Impian ${i+1}</strong>
                    <div class="grid-2 mt-1">
                        <input type="text" value="${u.nama}" onchange="appData.universitas[${i}].nama=this.value" placeholder="Nama Kampus">
                        <input type="text" value="${u.jurusan}" onchange="appData.universitas[${i}].jurusan=this.value" placeholder="Jurusan">
                        <div>
                            <label style="font-size:0.75rem;">Ganti Foto Kampus:</label>
                            <input type="file" accept="image/*" onchange="handleNestedImageUpload(this, 'universitas', ${i})">
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Image Handling via Base64 (Local Storage Persistence)
        function handleImageUpload(input, targetKey) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    appData[targetKey] = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function handleNestedImageUpload(input, arrayKey, index) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    appData[arrayKey][index].img = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function addKenangan() {
            const fileInput = document.getElementById('input-kenanganFile');
            const capInput = document.getElementById('input-kenanganCap');
            
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    appData.kenangan.push({
                        img: e.target.result,
                        cap: capInput.value || 'Foto Kenangan'
                    });
                    alert('Kenangan berhasil ditambahkan!');
                    capInput.value = '';
                    fileInput.value = '';
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                alert('Pilih foto terlebih dahulu!');
            }
        }

        function addNasihat() {
            const guru = document.getElementById('input-nasihatGuru').value;
            const teks = document.getElementById('input-nasihatTeks').value;

            if (guru && teks) {
                appData.nasihat.push({ guru, teks });
                alert('Nasihat berhasil ditambahkan!');
                document.getElementById('input-nasihatGuru').value = '';
                document.getElementById('input-nasihatTeks').value = '';
            } else {
                alert('Isi nama guru dan teks nasihat!');
            }
        }

        function saveAdminData(e) {
            e.preventDefault();
            
            const fields = [
                'nama','ttl','asalKota','alamatPribadi','hafalan','citaCita','hobi','motto',
                'alamatOrtu','namaAyah','ttlAyah','asalKotaAyah','smpAyah','smaAyah','kuliahAyah','pekerjaanAyah',
                'namaIbu','ttlIbu','asalKotaIbu','smpIbu','smaIbu','kuliahIbu','pekerjaanIbu','namaAnak',
                'wa','gmail','ig','fb','tiktok'
            ];

            fields.forEach(f => {
                const el = document.getElementById('input-' + f);
                if (el) appData[f] = el.value;
            });

            // Persist to LocalStorage
            localStorage.setItem('portfolioDataDB', JSON.stringify(appData));
            alert('Semua perubahan berhasil disimpan secara permanen!');
            renderUI();
            closeAdmin();
        }

        // Initialize App on Load
        window.onload = function() {
            renderUI();
        };
    </script>
</body>
</html>
