<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Pribadi & Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-glass: rgba(15, 23, 42, 0.75);
            --accent: #38bdf8;
            --accent-gradient: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
            --accent-hover: linear-gradient(135deg, #0284c7 0%, #6366f1 100%);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: rgba(255, 255, 255, 0.1);
            --radius-lg: 16px;
            --radius-sm: 8px;
            --shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(56, 189, 248, 0.08) 0%, transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(129, 140, 248, 0.08) 0%, transparent 25%);
            background-attachment: fixed;
        }

        /* Header Navigation */
        header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--bg-glass);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-size: 1.25rem;
            font-weight: 800;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        nav.tabs-nav {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 0.6rem 1.2rem;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.05);
        }

        .tab-btn.active {
            color: #fff;
            background: var(--accent-gradient);
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
        }

        .admin-trigger {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 0.5rem 1rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 0.85rem;
            transition: 0.3s;
        }

        .admin-trigger:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* Main Container */
        main {
            max-width: 1200px;
            width: 100%;
            margin: 2rem auto;
            padding: 0 1.5rem;
            flex-grow: 1;
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Glass Cards with Hover Effects */
        .glass-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            backdrop-filter: blur(8px);
            box-shadow: var(--shadow);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .interactive-card:hover {
            transform: translateY(-6px) scale(1.01);
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 0 15px 35px -10px rgba(56, 189, 248, 0.15);
        }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.75rem;
        }

        .section-title i { color: var(--accent); }

        /* Profile Layout */
        .profile-header {
            display: flex;
            gap: 2rem;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .profile-img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
        }

        .profile-info h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: 0.25rem; }
        .profile-info p { color: var(--text-muted); font-size: 1.1rem; }

        .data-list { display: flex; flex-direction: column; gap: 0.8rem; }
        .data-item {
            display: flex;
            justify-content: space-between;
            padding: 0.6rem 0;
            border-bottom: 1px dashed rgba(255,255,255,0.08);
        }
        .data-item .label { color: var(--text-muted); font-size: 0.9rem; }
        .data-item .val { font-weight: 600; text-align: right; }

        /* Photo Memories Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.2rem;
            margin-top: 1rem;
        }

        .gallery-item {
            overflow: hidden;
            border-radius: var(--radius-sm);
            background: rgba(0,0,0,0.3);
            border: 1px solid var(--border);
        }

        .gallery-item img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            transition: 0.3s;
        }

        .gallery-item:hover img { transform: scale(1.05); }
        .gallery-cap { padding: 0.75rem; font-size: 0.85rem; color: var(--text-muted); }

        /* Cards Layout for Education/Parents/Universities */
        .card-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: var(--radius-sm);
            margin-bottom: 1rem;
        }

        .badge {
            background: rgba(56, 189, 248, 0.1);
            color: var(--accent);
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 0.5rem;
        }

        /* Quotes/Advice Section */
        .quote-card {
            position: relative;
            padding: 2rem;
            border-left: 4px solid var(--accent);
        }

        .quote-card i.quote-icon {
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.3;
            position: absolute;
            top: 1rem;
            right: 1rem;
        }

        /* Social Media Icons */
        .social-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.2rem;
            text-decoration: none;
            color: var(--text-main);
            border-radius: var(--radius-sm);
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .social-link:hover {
            background: rgba(255,255,255,0.08);
            transform: translateX(8px);
        }

        .social-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        /* Admin Modal Dashboard */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            z-index: 1000;
            overflow-y: auto;
            padding: 2rem 1rem;
        }

        .modal-content {
            background: #1e293b;
            border: 1px solid var(--border);
            max-width: 900px;
            margin: auto;
            border-radius: var(--radius-lg);
            padding: 2rem;
            color: var(--text-main);
        }

        .admin-form-group {
            margin-bottom: 1.2rem;
        }

        .admin-form-group label {
            display: block;
            margin-bottom: 0.4rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .admin-form-group input, .admin-form-group textarea, .admin-form-group select {
            width: 100%;
            padding: 0.75rem;
            background: #0f172a;
            border: 1px solid var(--border);
            color: #fff;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
        }

        .admin-btn {
            background: var(--accent-gradient);
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-weight: 600;
        }

        .login-box {
            max-width: 400px;
            margin: 10vh auto;
            text-align: center;
        }

        /* Utility */
        .mt-1 { margin-top: 1rem; }
        .mt-2 { margin-top: 2rem; }
        
        @media (max-width: 768px) {
            header { flex-direction: column; gap: 1rem; padding: 1rem; }
            nav.tabs-nav { width: 100%; }
            .profile-header { text-align: center; justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- Header Navigation Tabs -->
    <header>
        <div class="brand"><i class="fa-solid fa-graduation-cap"></i> Portofolio</div>
        <nav class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab(0)"><i class="fa-solid fa-user"></i> Beranda</button>
            <button class="tab-btn" onclick="switchTab(1)"><i class="fa-solid fa-users"></i> Data Orangtua</button>
            <button class="tab-btn" onclick="switchTab(2)"><i class="fa-solid fa-school"></i> Pendidikan</button>
            <button class="tab-btn" onclick="switchTab(3)"><i class="fa-solid fa-trophy"></i> Prestasi & Impian</button>
            <button class="tab-btn" onclick="switchTab(4)"><i class="fa-solid fa-share-nodes"></i> Media Sosial</button>
            <button class="tab-btn" onclick="switchTab(5)"><i class="fa-solid fa-book-quran"></i> Nasihat Guru</button>
        </nav>
        <button class="admin-trigger" onclick="openAdmin()"><i class="fa-solid fa-lock"></i> Admin</button>
    </header>

    <!-- Main Content Area -->
    <main>

        <!-- TAB 1: BERANDA (DATA PRIBADI) -->
        <div class="tab-content active" id="tab-0">
            <div class="glass-card profile-header interactive-card">
                <img src="" id="display-fotoProfil" class="profile-img" alt="Foto Profil">
                <div class="profile-info">
                    <h1 id="display-nama">...</h1>
                    <p id="display-motto" style="font-style: italic; color: var(--accent);">"..."</p>
                </div>
            </div>

            <div class="grid-2">
                <div class="glass-card interactive-card">
                    <h2 class="section-title"><i class="fa-solid fa-id-card"></i> Data Pribadi</h2>
                    <div class="data-list">
                        <div class="data-item"><span class="label">Tempat, Tgl Lahir</span><span class="val" id="display-ttl">...</span></div>
                        <div class="data-item"><span class="label">Asal Kota</span><span class="val" id="display-asalKota">...</span></div>
                        <div class="data-item"><span class="label">Alamat Tinggal</span><span class="val" id="display-alamatPribadi">...</span></div>
                        <div class="data-item"><span class="label">Hafalan Al-Qur'an</span><span class="val" id="display-hafalan">...</span></div>
                        <div class="data-item"><span class="label">Cita-Cita</span><span class="val" id="display-citaCita">...</span></div>
                        <div class="data-item"><span class="label">Hobi</span><span class="val" id="display-hobi">...</span></div>
                    </div>
                </div>

                <div class="glass-card interactive-card">
                    <h2 class="section-title"><i class="fa-solid fa-images"></i> Galeri Kenangan</h2>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Momen berharga dalam perjalanan hidup.</p>
                    <div class="gallery-grid" id="display-kenanganGrid">
