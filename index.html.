                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DATA ORANGTUA -->
        <div class="tab-content" id="tab-1">
            <div class="grid-2">
                <!-- Data Ayah -->
                <div class="glass-card interactive-card">
                    <span class="badge">Orangtua</span>
                    <h2 class="section-title"><i class="fa-solid fa-user-tie"></i> Data Ayah</h2>
                    <div class="data-list">
                        <div class="data-item"><span class="label">Nama Ayah</span><span class="val" id="display-namaAyah">...</span></div>
                        <div class="data-item"><span class="label">TTL</span><span class="val" id="display-ttlAyah">...</span></div>
                        <div class="data-item"><span class="label">Asal Kota</span><span class="val" id="display-asalKotaAyah">...</span></div>
                        <div class="data-item"><span class="label">Alamat</span><span class="val" id="display-alamatOrtu">...</span></div>
                        <div class="data-item"><span class="label">Pendidikan SMP</span><span class="val" id="display-smpAyah">...</span></div>
                        <div class="data-item"><span class="label">Pendidikan SMA</span><span class="val" id="display-smaAyah">...</span></div>
                        <div class="data-item"><span class="label">Perguruan Tinggi</span><span class="val" id="display-kuliahAyah">...</span></div>
                        <div class="data-item"><span class="label">Pekerjaan</span><span class="val" id="display-pekerjaanAyah">...</span></div>
                    </div>
                </div>

                <!-- Data Ibu & Anak -->
                <div class="glass-card interactive-card">
                    <span class="badge">Orangtua</span>
                    <h2 class="section-title"><i class="fa-solid fa-user-nurse"></i> Data Ibu & Keluarga</h2>
                    <div class="data-list">
                        <div class="data-item"><span class="label">Nama Ibu</span><span class="val" id="display-namaIbu">...</span></div>
                        <div class="data-item"><span class="label">TTL</span><span class="val" id="display-ttlIbu">...</span></div>
                        <div class="data-item"><span class="label">Asal Kota</span><span class="val" id="display-asalKotaIbu">...</span></div>
                        <div class="data-item"><span class="label">Pendidikan SMP</span><span class="val" id="display-smpIbu">...</span></div>
                        <div class="data-item"><span class="label">Pendidikan SMA</span><span class="val" id="display-smaIbu">...</span></div>
                        <div class="data-item"><span class="label">Perguruan Tinggi</span><span class="val" id="display-kuliahIbu">...</span></div>
                        <div class="data-item"><span class="label">Pekerjaan</span><span class="val" id="display-pekerjaanIbu">...</span></div>
                        <div class="data-item"><span class="label">Nama Anak-anak</span><span class="val" id="display-namaAnak">...</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: PENDIDIKAN -->
        <div class="tab-content" id="tab-2">
            <h2 class="section-title"><i class="fa-solid fa-graduation-cap"></i> Riwayat Pendidikan</h2>
            <div class="grid-3" id="display-pendidikanGrid">
                <!-- Educational levels dynamically injected -->
            </div>
        </div>

        <!-- TAB 4: PRESTASI & UNIVERSITAS IMPIAN -->
        <div class="tab-content" id="tab-3">
            <h2 class="section-title"><i class="fa-solid fa-award"></i> Prestasi Akademik & Non-Akademik</h2>
            <div class="grid-3" id="display-prestasiGrid" style="margin-bottom: 3rem;">
                <!-- Prestasi dynamically injected -->
            </div>

            <h2 class="section-title"><i class="fa-solid fa-building-columns"></i> 3 Universitas Impian & Jurusan</h2>
            <div class="grid-3" id="display-univGrid">
                <!-- Target Universities injected -->
            </div>
        </div>

        <!-- TAB 5: MEDIA SOSIAL -->
        <div class="tab-content" id="tab-4">
            <h2 class="section-title"><i class="fa-solid fa-hashtag"></i> Hubungi & Ikuti Saya</h2>
            <div class="grid-2 mt-1">
                <a href="#" id="link-wa" target="_blank" class="social-link interactive-card">
                    <div class="social-icon" style="background: #25D366; color: white;"><i class="fa-brands fa-whatsapp"></i></div>
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">WhatsApp</div>
                        <div style="font-weight: 700;" id="display-wa">...</div>
                    </div>
                </a>

                <a href="#" id="link-gmail" target="_blank" class="social-link interactive-card">
                    <div class="social-icon" style="background: #EA4335; color: white;"><i class="fa-regular fa-envelope"></i></div>
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Gmail</div>
                        <div style="font-weight: 700;" id="display-gmail">...</div>
                    </div>
                </a>

                <a href="#" id="link-ig" target="_blank" class="social-link interactive-card">
                    <div class="social-icon" style="background: linear-gradient(45deg, #f09433, #bc1888); color: white;"><i class="fa-brands fa-instagram"></i></div>
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Instagram</div>
                        <div style="font-weight: 700;" id="display-ig">...</div>
                    </div>
                </a>

                <a href="#" id="link-fb" target="_blank" class="social-link interactive-card">
                    <div class="social-icon" style="background: #1877F2; color: white;"><i class="fa-brands fa-facebook"></i></div>
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Facebook</div>
                        <div style="font-weight: 700;" id="display-fb">...</div>
                    </div>
                </a>

                <a href="#" id="link-tiktok" target="_blank" class="social-link interactive-card">
                    <div class="social-icon" style="background: #000000; color: white; border: 1px solid var(--border);"><i class="fa-brands fa-tiktok"></i></div>
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">TikTok</div>
                        <div style="font-weight: 700;" id="display-tiktok">...</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- TAB 6: NASIHAT GURU / MASYAIKH -->
        <div class="tab-content" id="tab-5">
            <h2 class="section-title"><i class="fa-solid fa-quote-left"></i> Nasihat Guru & Masyaikh</h2>
            <div class="grid-2 mt-1" id="display-nasihatGrid">
                <!-- Quotes dynamically loaded -->
            </div>
        </div>

    </main>

    <!-- ADMIN MODAL SYSTEM -->
    <div class="modal" id="adminModal">
        <!-- Login Screen -->
        <div class="modal-content login-box" id="adminLoginScreen">
            <h2 style="margin-bottom: 1rem;"><i class="fa-solid fa-user-shield"></i> Login Admin</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Masukkan kata sandi untuk mengedit isi portofolio.</p>
            <div class="admin-form-group">
                <input type="password" id="adminPasswordInput" placeholder="Password Admin">
            </div>
            <button class="admin-btn" style="width: 100%;" onclick="verifyAdmin()">Masuk Dashboard</button>
            <button class="admin-trigger" style="width: 100%; margin-top: 0.5rem;" onclick="closeAdmin()">Batal</button>
        </div>

        <!-- Dashboard Screen -->
        <div class="modal-content" id="adminDashboardScreen" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                <h2><i class="fa-solid fa-sliders"></i> Control Panel Admin</h2>
                <button class="admin-trigger" onclick="closeAdmin()">Tutup & Lihat Hasil</button>
            </div>

            <form id="adminForm" onsubmit="saveAdminData(event)">
                
                <!-- Section 1: Data Pribadi -->
                <h3 style="color: var(--accent); margin-bottom: 1rem;">1. Data Pribadi</h3>
                <div class="grid-2">
                    <div class="admin-form-group">
                        <label>Foto Profil (Upload)</label>
                        <input type="file" accept="image/*" onchange="handleImageUpload(this, 'fotoProfil')">
                    </div>
                    <div class="admin-form-group">
                        <label>Nama Lengkap</label>
                        <input type="text" id="input-nama">
                    </div>
                    <div class="admin-form-group">
                        <label>Tempat, Tanggal Lahir</label>
                        <input type="text" id="input-ttl">
                    </div>
                    <div class="admin-form-group">
                        <label>Asal Kota</label>
                        <input type="text" id="input-asalKota">
                    </div>
                    <div class="admin-form-group">
                        <label>Alamat Tempat Tinggal</label>
                        <input type="text" id="input-alamatPribadi">
                    </div>
                    <div class="admin-form-group">
                        <label>Hafalan Al-Qur'an</label>
                        <input type="text" id="input-hafalan">
                    </div>
                    <div class="admin-form-group">
                        <label>Cita-Cita</label>
                        <input type="text" id="input-citaCita">
                    </div>
                    <div class="admin-form-group">
                        <label>Hobi</label>
                        <input type="text" id="input-hobi">
                    </div>
                </div>
                <div class="admin-form-group">
                    <label>Motto Hidup</label>
                    <input type="text" id="input-motto">
                </div>

                <!-- Section 2: Data Orangtua -->
                <h3 style="color: var(--accent); margin-top: 2rem; margin-bottom: 1rem;">2. Data Orangtua</h3>
                <div class="admin-form-group">
                    <label>Alamat Tempat Tinggal Orangtua</label>
                    <input type="text" id="input-alamatOrtu">
                </div>
                <div class="grid-2">
                    <!-- Ayah -->
                    <div>
                        <h4 style="margin-bottom:0.5rem; color:var(--text-muted);">Ayah</h4>
                        <div class="admin-form-group"><label>Nama Ayah</label><input type="text" id="input-namaAyah"></div>
                        <div class="admin-form-group"><label>TTL Ayah</label><input type="text" id="input-ttlAyah"></div>
                        <div class="admin-form-group"><label>Asal Kota Ayah</label><input type="text" id="input-asalKotaAyah"></div>
                        <div class="admin-form-group"><label>Pendidikan SMP</label><input type="text" id="input-smpAyah"></div>
                        <div class="admin-form-group"><label>Pendidikan SMA</label><input type="text" id="input-smaAyah"></div>
                        <div class="admin-form-group"><label>Kuliah</label><input type="text" id="input-kuliahAyah"></div>
                        <div class="admin-form-group"><label>Pekerjaan</label><input type="text" id="input-pekerjaanAyah"></div>
                    </div>
                    <!-- Ibu -->
                    <div>
                        <h4 style="margin-bottom:0.5rem; color:var(--text-muted);">Ibu</h4>
                        <div class="admin-form-group"><label>Nama Ibu</label><input type="text" id="input-namaIbu"></div>
                        <div class="admin-form-group"><label>TTL Ibu</label><input type="text" id="input-ttlIbu"></div>
                        <div class="admin-form-group"><label>Asal Kota Ibu</label><input type="text" id="input-asalKotaIbu"></div>
                        <div class="admin-form-group"><label>Pendidikan SMP</label><input type="text" id="input-smpIbu"></div>
                        <div class="admin-form-group"><label>Pendidikan SMA</label><input type="text" id="input-smaIbu"></div>
                        <div class="admin-form-group"><label>Kuliah</label><input type="text" id="input-kuliahIbu"></div>
                        <div class="admin-form-group"><label>Pekerjaan</label><input type="text" id="input-pekerjaanIbu"></div>
